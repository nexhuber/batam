# Install once as /etc/nginx/sites-available/batam-dashboard.
# Keep the existing site name to avoid duplicate server blocks on upgrades.
# DNS: ba8.nexhubco.vn -> VPS IP. Certbot adds HTTPS to the installed file.
# sudo certbot --nginx -d ba8.nexhubco.vn
# If BATAM_PORT changes, update proxy_pass in the installed site manually.
server {
    listen 80;
    listen [::]:80;
    server_name ba8.nexhubco.vn;

    location / {
        proxy_pass http://127.0.0.1:3105;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 60s;
    }
}
