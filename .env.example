# Sao chép file này thành .env.local khi chạy local, hoặc .env trên VPS.
# Không commit file chứa giá trị thật.

# ── Ứng dụng / cổng chạy local ─────────────────────────────────────────────
# Next.js dùng PORT khi chạy yarn dev hoặc yarn start.
# Deploy VPS dùng BATAM_PORT (mặc định 3200) trong script deploy, không lấy PORT ở đây.
PORT=3000

# ── Phiên đăng nhập Batam ─────────────────────────────────────────────────
# Khóa riêng để ký OAuth state và cookie phiên. Tạo bằng: openssl rand -hex 32
SESSION_SECRET=

# ── Đăng nhập Lark ────────────────────────────────────────────────────────
# ID và secret của Lark Custom App.
LARK_APP_ID=
LARK_APP_SECRET=
# Phải trùng chính xác callback đã đăng ký trong Lark console.
LARK_REDIRECT_URI=http://localhost:3000/auth/callback
# Chỉ đặt khi dùng Lark endpoint khác mặc định https://open.larksuite.com.
# LARK_BASE_URL=https://open.larksuite.com

# ── Google Cloud / BigQuery ───────────────────────────────────────────────
# Đường dẫn tuyệt đối đến service-account JSON; để trống nếu dùng ADC.
GOOGLE_APPLICATION_CREDENTIALS=
# Project chạy query, dataset lưu news và location của BigQuery job.
BQ_PROJECT=
BQ_DATASET=news
BQ_LOCATION=asia-southeast1

# ── API báo cáo tồn kho Brand từ Monarch ──────────────────────────────────
# Origin của Monarch, không có path; token phải trùng cấu hình phía Monarch.
MONARCH_API_BASE_URL=https://monarch.example.com
BRAND_PIVOT_API_TOKEN=
