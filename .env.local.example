# Copy to .env.local and fill in your own values.
SESSION_SECRET=
LARK_APP_ID=
LARK_APP_SECRET=
# Must exactly match the redirect URL registered in the Lark app.
LARK_REDIRECT_URI=http://localhost:3000/auth/callback
# Optional; defaults to https://open.larksuite.com.
# LARK_BASE_URL=https://open.larksuite.com

# Absolute path to a Google service-account JSON file; alternatively use ADC.
GOOGLE_APPLICATION_CREDENTIALS=
BQ_PROJECT=
BQ_DATASET=news
BQ_LOCATION=asia-southeast1

# Server-side access to Monarch's Brand × Kỳ API
MONARCH_API_BASE_URL=https://monarch.example.com
# Must match BRAND_PIVOT_API_TOKEN configured in Monarch
BRAND_PIVOT_API_TOKEN=
